# Explicitly enable fictional identities for loopback npm run dev only.
# Ignored by production builds / npm run preview, even if set to true.
DEV_AUTH_ENABLED=true

# For real Cloudflare mode, disable DEV_AUTH_ENABLED and configure these:
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-access-application-audience
FAMILY_CONFIG_PATH=config/family.private.json
DRAW_PATH=data/draw.private.json
