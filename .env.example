# Explicitly bypass Cloudflare Google login for loopback npm run dev only.
# Ignored by production builds / npm run preview, even if set to true.
DEV_AUTH_ENABLED=true
# fictional: committed config/family.example.json and fixed example draw.
# private: FAMILY_CONFIG_PATH plus a separate DEV_DRAW_PATH for local reveals.
DEV_FAMILY_SOURCE=fictional
# Created once at private-family dev initialization if absent.
DEV_DRAW_PATH=config/draw.dev.private.json

# For real Cloudflare mode, disable DEV_AUTH_ENABLED and configure these:
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-access-application-audience
FAMILY_CONFIG_PATH=config/family.private.json
# Created once at production server initialization if absent; mount config writable.
DRAW_PATH=config/draw.private.json
